{
  "inclusion_criteria": [
    {
      "id": 2922,
      "text": "Age ≥ 18 years.",
      "logic": {
        "field": "age",
        "operator": ">=",
        "value": "18"
      }
    },
    {
      "id": 2923,
      "text": "Histologically or cytologically confirmed metastatic NSCLC (Stage IV).",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "diagnosis",
            "operator": "=",
            "value": "NSCLC"
          },
          {
            "field": "stage",
            "operator": "=",
            "value": "IV"
          }
        ]
      }
    },
    {
      "id": 2924,
      "text": "Documented progression after first-line platinum-based chemotherapy combined with anti-PD-1 or anti-PD-L1 therapy.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "treatment_name",
            "operator": "CONTAINS",
            "value": "platinum"
          },
          {
            "operator": "OR",
            "conditions": [
              {
                "field": "treatment_name",
                "operator": "CONTAINS",
                "value": "anti-PD-1"
              },
              {
                "field": "treatment_name",
                "operator": "CONTAINS",
                "value": "anti-PD-L1"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2925,
      "text": "ECOG Performance Status 0–1.",
      "logic": {
        "field": "ecog_ps",
        "operator": "IN",
        "value": "0,1"
      }
    },
    {
      "id": 2926,
      "text": "At least one measurable lesion per RECIST 1.1.",
      "logic": {
        "field": "measurable_lesion_count",
        "operator": ">=",
        "value": "1"
      }
    },
    {
      "id": 2927,
      "text": "Absolute neutrophil count (ANC) ≥ 1.5 x 10^9/L",
      "logic": {
        "field": "neutrofilos",
        "operator": ">=",
        "value": "1.5",
        "unit": "x 10^9/L"
      }
    },
    {
      "id": 2928,
      "text": "Platelets ≥ 100 x 10^9/L",
      "logic": {
        "field": "plaquetas",
        "operator": ">=",
        "value": "100",
        "unit": "x 10^9/L"
      }
    },
    {
      "id": 2929,
      "text": "Hemoglobin ≥ 9 g/dL",
      "logic": {
        "field": "hemoglobina",
        "operator": ">=",
        "value": "9",
        "unit": "g/dL"
      }
    },
    {
      "id": 2930,
      "text": "AST and ALT ≤ 2.5 x ULN (≤ 5 x ULN if liver metastases)",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "ast",
            "operator": "<=",
            "value": "2.5",
            "unit": "x ULN"
          },
          {
            "field": "alt",
            "operator": "<=",
            "value": "2.5",
            "unit": "x ULN"
          },
          {
            "unmapped": true,
            "source_text": "≤ 5 x ULN if liver metastases"
          }
        ]
      }
    },
    {
      "id": 2931,
      "text": "Total bilirubin ≤ 1.5 x ULN",
      "logic": {
        "field": "bilirrubina_total",
        "operator": "<=",
        "value": "1.5",
        "unit": "x ULN"
      }
    },
    {
      "id": 2932,
      "text": "Creatinine clearance ≥ 40 mL/min (CKD-EPI formula)",
      "logic": {
        "field": "creatinine_clearance",
        "operator": ">=",
        "value": "40",
        "unit": "mL/min"
      }
    },
    {
      "id": 2933,
      "text": "Women of childbearing potential must have a negative pregnancy test prior to treatment initiation.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "gender",
            "operator": "=",
            "value": "female"
          },
          {
            "field": "pregnancy_test",
            "operator": "=",
            "value": "negative"
          }
        ]
      }
    },
    {
      "id": 2934,
      "text": "Signed informed consent prior to any study-specific procedure.",
      "logic": {
        "field": "informed_consent_signed",
        "operator": "=",
        "value": "true"
      }
    }
  ],
  "exclusion_criteria": [
    {
      "id": 2935,
      "text": "Known EGFR genomic alteration with available approved targeted therapy",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "molecular_status",
            "operator": "=",
            "value": "EGFR"
          },
          {
            "field": "approved_targeted_therapy_available",
            "operator": "=",
            "value": "yes"
          }
        ]
      }
    },
    {
      "id": 2936,
      "text": "Untreated brain metastases",
      "logic": {
        "field": "brain_metastases_treatment",
        "operator": "=",
        "value": "untreated"
      }
    },
    {
      "id": 2937,
      "text": "Symptomatic brain metastases",
      "logic": {
        "field": "brain_metastases_symptomatic",
        "operator": "=",
        "value": "yes"
      }
    },
    {
      "id": 2938,
      "text": "Active autoimmune disease requiring systemic immunosuppressive therapy",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "autoimmune_disease_status",
            "operator": "=",
            "value": "active"
          },
          {
            "field": "immunosuppressive_therapy_required",
            "operator": "=",
            "value": "yes"
          }
        ]
      }
    },
    {
      "id": 2939,
      "text": "Interstitial lung disease",
      "logic": {
        "field": "interstitial_lung_disease",
        "operator": "=",
        "value": "present"
      }
    },
    {
      "id": 2940,
      "text": "Active non-infectious pneumonitis",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "pneumonitis_status",
            "operator": "=",
            "value": "active"
          },
          {
            "field": "pneumonitis_infection_type",
            "operator": "=",
            "value": "non_infectious"
          }
        ]
      }
    },
    {
      "id": 2941,
      "text": "Active infection requiring systemic therapy",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "infection_status",
            "operator": "=",
            "value": "active"
          },
          {
            "field": "infection_treatment",
            "operator": "=",
            "value": "systemic_therapy"
          }
        ]
      }
    },
    {
      "id": 2942,
      "text": "Prior exposure to LUMITAX",
      "logic": {
        "field": "lumitax_exposure",
        "operator": "=",
        "value": "yes"
      }
    },
    {
      "id": 2943,
      "text": "Other active invasive malignancy within 3 years (except adequately treated non-melanoma skin cancer or carcinoma in situ)",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "active_invasive_malignancy",
            "operator": "=",
            "value": "yes"
          },
          {
            "field": "malignancy_type",
            "operator": "NOT_IN",
            "value": "non-melanoma skin cancer"
          },
          {
            "field": "malignancy_type",
            "operator": "NOT_IN",
            "value": "carcinoma in situ"
          }
        ]
      }
    }
  ]
}