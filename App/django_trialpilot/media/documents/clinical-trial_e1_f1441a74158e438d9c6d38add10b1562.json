{
  "inclusion_criteria": [
    {
      "id": 2644,
      "text": "Age ≥ 18 years.",
      "logic": {
        "field": "age",
        "operator": ">=",
        "value": "18"
      }
    },
    {
      "id": 2645,
      "text": "Histologically or cytologically confirmed metastatic NSCLC (Stage IV).",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "diagnosis",
            "operator": "=",
            "value": "NSCLC"
          },
          {
            "field": "stage",
            "operator": "=",
            "value": "IV"
          }
        ]
      }
    },
    {
      "id": 2646,
      "text": "Documented progression after first-line platinum-based chemotherapy combined with anti-PD-1 or anti-PD-L1 therapy.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "progression_documented",
            "operator": "=",
            "value": "yes"
          },
          {
            "operator": "AND",
            "conditions": [
              {
                "field": "treatment_name",
                "operator": "CONTAINS",
                "value": "platinum"
              },
              {
                "operator": "OR",
                "conditions": [
                  {
                    "field": "treatment_name",
                    "operator": "CONTAINS",
                    "value": "anti-PD-1"
                  },
                  {
                    "field": "treatment_name",
                    "operator": "CONTAINS",
                    "value": "anti-PD-L1"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2647,
      "text": "ECOG Performance Status 0–1.",
      "logic": {
        "field": "ecog_ps",
        "operator": "IN",
        "value": [
          "0",
          "1"
        ]
      }
    },
    {
      "id": 2648,
      "text": "At least one measurable lesion per RECIST 1.1.",
      "logic": {
        "field": "measurable_lesion",
        "operator": "=",
        "value": "yes"
      }
    },
    {
      "id": 2649,
      "text": "Absolute neutrophil count (ANC) ≥ 1.5 x 10^9/L",
      "logic": {
        "field": "absolute_neutrophil_count",
        "operator": ">=",
        "value": "1.5"
      }
    },
    {
      "id": 2650,
      "text": "Platelets ≥ 100 x 10^9/L",
      "logic": {
        "field": "platelet_count",
        "operator": ">=",
        "value": "100"
      }
    },
    {
      "id": 2651,
      "text": "Hemoglobin ≥ 9 g/dL",
      "logic": {
        "field": "hemoglobin",
        "operator": ">=",
        "value": "9"
      }
    },
    {
      "id": 2652,
      "text": "AST and ALT ≤ 2.5 x ULN (≤ 5 x ULN if liver metastases)",
      "logic": {
        "operator": "OR",
        "conditions": [
          {
            "operator": "AND",
            "conditions": [
              {
                "field": "ast",
                "operator": "<=",
                "value": "2.5"
              },
              {
                "field": "alt",
                "operator": "<=",
                "value": "2.5"
              }
            ]
          },
          {
            "operator": "AND",
            "conditions": [
              {
                "field": "liver_metastases",
                "operator": "=",
                "value": "true"
              },
              {
                "field": "ast",
                "operator": "<=",
                "value": "5"
              },
              {
                "field": "alt",
                "operator": "<=",
                "value": "5"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2653,
      "text": "Total bilirubin ≤ 1.5 x ULN",
      "logic": {
        "field": "total_bilirubin",
        "operator": "<=",
        "value": "1.5"
      }
    },
    {
      "id": 2654,
      "text": "Creatinine clearance ≥ 40 mL/min (CKD-EPI formula)",
      "logic": {
        "field": "creatinine_clearance",
        "operator": ">=",
        "value": "40"
      }
    },
    {
      "id": 2655,
      "text": "Women of childbearing potential must have a negative pregnancy test prior to treatment initiation.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "sex",
            "operator": "=",
            "value": "female"
          },
          {
            "field": "pregnancy_test_result",
            "operator": "=",
            "value": "negative"
          }
        ]
      }
    },
    {
      "id": 2656,
      "text": "Signed informed consent prior to any study-specific procedure.",
      "logic": {
        "field": "informed_consent_signed",
        "operator": "=",
        "value": "true"
      }
    }
  ],
  "exclusion_criteria": [
    {
      "id": 2657,
      "text": "Known EGFR, ALK, or ROS1 genomic alterations with available approved targeted therapy.",
      "logic": {
        "field": "molecular_status",
        "operator": "IN",
        "value": "EGFR,ALK,ROS1"
      }
    },
    {
      "id": 2658,
      "text": "Untreated brain metastases.",
      "logic": {
        "field": "brain_metastases_treatment",
        "operator": "=",
        "value": "untreated"
      }
    },
    {
      "id": 2659,
      "text": "Symptomatic brain metastases.",
      "logic": {
        "field": "brain_metastases_symptomatic",
        "operator": "=",
        "value": "symptomatic"
      }
    },
    {
      "id": 2660,
      "text": "Active autoimmune disease requiring systemic immunosuppressive therapy.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "autoimmune_disease_status",
            "operator": "=",
            "value": "active"
          },
          {
            "field": "systemic_immunosuppressive_therapy",
            "operator": "=",
            "value": "required"
          }
        ]
      }
    },
    {
      "id": 2661,
      "text": "Interstitial lung disease.",
      "logic": {
        "field": "interstitial_lung_disease",
        "operator": "=",
        "value": "present"
      }
    },
    {
      "id": 2662,
      "text": "Active non-infectious pneumonitis.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "pneumonitis_status",
            "operator": "=",
            "value": "active"
          },
          {
            "field": "pneumonitis_type",
            "operator": "=",
            "value": "non-infectious"
          }
        ]
      }
    },
    {
      "id": 2663,
      "text": "Active infection requiring systemic therapy.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "infection_status",
            "operator": "=",
            "value": "active"
          },
          {
            "field": "infection_treatment",
            "operator": "=",
            "value": "systemic"
          }
        ]
      }
    },
    {
      "id": 2664,
      "text": "Prior exposure to LUMITAX.",
      "logic": {
        "field": "lumitax_exposure",
        "operator": "=",
        "value": "yes"
      }
    },
    {
      "id": 2665,
      "text": "Other active invasive malignancy within 3 years (except adequately treated non-melanoma skin cancer or carcinoma in situ).",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "active_invasive_malignancy",
            "operator": "=",
            "value": "yes"
          },
          {
            "field": "malignancy_time_since_diagnosis_years",
            "operator": "<=",
            "value": "3"
          },
          {
            "field": "diagnosis",
            "operator": "NOT_IN",
            "value": "non-melanoma skin cancer"
          },
          {
            "field": "diagnosis",
            "operator": "NOT_IN",
            "value": "carcinoma in situ"
          }
        ]
      }
    }
  ]
}