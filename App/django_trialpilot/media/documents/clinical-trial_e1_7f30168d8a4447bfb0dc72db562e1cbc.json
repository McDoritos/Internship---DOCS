{
  "inclusion_criteria": [
    {
      "id": 2986,
      "text": "Age ≥ 18 years.",
      "logic": {
        "field": "age",
        "operator": ">=",
        "value": "18"
      }
    },
    {
      "id": 2987,
      "text": "Histologically or cytologically confirmed metastatic NSCLC (Stage IV).",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "diagnosis",
            "operator": "=",
            "value": "NSCLC"
          },
          {
            "field": "stage",
            "operator": "=",
            "value": "IV"
          }
        ]
      }
    },
    {
      "id": 2988,
      "text": "Documented progression after first-line platinum-based chemotherapy combined with anti-PD-1 or anti-PD-L1 therapy.",
      "logic": {
        "field": "prior_therapy",
        "operator": "=",
        "value": "platinum-based chemotherapy with anti-PD-1 or anti-PD-L1"
      }
    },
    {
      "id": 2989,
      "text": "ECOG Performance Status 0–1.",
      "logic": {
        "field": "ecog_ps",
        "operator": "<=",
        "value": "1"
      }
    },
    {
      "id": 2990,
      "text": "At least one measurable lesion per RECIST 1.1.",
      "logic": {
        "field": "measurable_lesions",
        "operator": ">=",
        "value": "1"
      }
    },
    {
      "id": 2991,
      "text": "Absolute neutrophil count (ANC) ≥ 1.5 x 10^9/L",
      "logic": {
        "field": "neutrofilos",
        "operator": ">=",
        "value": "1.5",
        "unit": "x 10^9/L"
      }
    },
    {
      "id": 2992,
      "text": "Platelets ≥ 100 x 10^9/L",
      "logic": {
        "field": "plaquetas",
        "operator": ">=",
        "value": "100",
        "unit": "x 10^9/L"
      }
    },
    {
      "id": 2993,
      "text": "Hemoglobin ≥ 9 g/dL",
      "logic": {
        "field": "hemoglobina",
        "operator": ">=",
        "value": "9",
        "unit": "g/dL"
      }
    },
    {
      "id": 2994,
      "text": "AST and ALT ≤ 2.5 x ULN (≤ 5 x ULN if liver metastases)",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "ast",
            "operator": "<=",
            "value": "2.5",
            "unit": "x ULN"
          },
          {
            "field": "alt",
            "operator": "<=",
            "value": "2.5",
            "unit": "x ULN"
          }
        ]
      }
    },
    {
      "id": 2995,
      "text": "Total bilirubin ≤ 1.5 x ULN",
      "logic": {
        "field": "bilirrubina_total",
        "operator": "<=",
        "value": "1.5",
        "unit": "x ULN"
      }
    },
    {
      "id": 2996,
      "text": "Creatinine clearance ≥ 40 mL/min (CKD-EPI formula)",
      "logic": {
        "field": "creatinine_clearance",
        "operator": ">=",
        "value": "40",
        "unit": "mL/min"
      }
    },
    {
      "id": 2997,
      "text": "Women of childbearing potential must have a negative pregnancy test prior to treatment initiation.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "gender",
            "operator": "=",
            "value": "female"
          },
          {
            "field": "pregnancy_test_result",
            "operator": "=",
            "value": "negative"
          }
        ]
      }
    },
    {
      "id": 2998,
      "text": "Signed informed consent prior to any study-specific procedure.",
      "logic": {
        "field": "informed_consent_status",
        "operator": "=",
        "value": "signed"
      }
    }
  ],
  "exclusion_criteria": [
    {
      "id": 2999,
      "text": "Known EGFR, ALK, or ROS1 genomic alterations with available approved targeted therapy.",
      "logic": {
        "operator": "OR",
        "conditions": [
          {
            "field": "egfr_genomic_alteration",
            "operator": "=",
            "value": "true"
          },
          {
            "field": "alk_genomic_alteration",
            "operator": "=",
            "value": "true"
          },
          {
            "field": "ros1_genomic_alteration",
            "operator": "=",
            "value": "true"
          }
        ]
      }
    },
    {
      "id": 3000,
      "text": "Untreated or symptomatic brain metastases.",
      "logic": {
        "operator": "OR",
        "conditions": [
          {
            "field": "brain_metastases_treatment_status",
            "operator": "=",
            "value": "untreated"
          },
          {
            "field": "brain_metastases_symptom_status",
            "operator": "=",
            "value": "symptomatic"
          }
        ]
      }
    },
    {
      "id": 3001,
      "text": "Active autoimmune disease requiring systemic immunosuppressive therapy.",
      "logic": {
        "field": "autoimmune_disease_status",
        "operator": "=",
        "value": "active"
      }
    },
    {
      "id": 3002,
      "text": "Interstitial lung disease or active non-infectious pneumonitis.",
      "logic": {
        "operator": "OR",
        "conditions": [
          {
            "field": "interstitial_lung_disease_status",
            "operator": "=",
            "value": "present"
          },
          {
            "field": "non_infectious_pneumonitis_status",
            "operator": "=",
            "value": "active"
          }
        ]
      }
    },
    {
      "id": 3003,
      "text": "Active infection requiring systemic therapy.",
      "logic": {
        "field": "infection_status",
        "operator": "=",
        "value": "active"
      }
    },
    {
      "id": 3004,
      "text": "Prior exposure to LUMITAX.",
      "logic": {
        "field": "treatment_name",
        "operator": "IN",
        "value": "LUMITAX"
      }
    },
    {
      "id": 3005,
      "text": "Other active invasive malignancy within 3 years (except adequately treated non-melanoma skin cancer or carcinoma in situ).",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "diagnosis_date",
            "operator": "<=",
            "value": "3 years ago"
          },
          {
            "field": "diagnosis",
            "operator": "NOT_IN",
            "value": "non-melanoma skin cancer"
          },
          {
            "field": "diagnosis",
            "operator": "NOT_IN",
            "value": "carcinoma in situ"
          },
          {
            "field": "malignancy_status",
            "operator": "=",
            "value": "active"
          }
        ]
      }
    }
  ]
}