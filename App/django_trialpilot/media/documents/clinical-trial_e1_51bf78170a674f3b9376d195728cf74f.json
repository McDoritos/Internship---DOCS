{
  "inclusion_criteria": [
    {
      "id": 2666,
      "text": "Age ≥ 18 years.",
      "logic": {
        "field": "age",
        "operator": ">=",
        "value": "18"
      }
    },
    {
      "id": 2667,
      "text": "Histologically or cytologically confirmed metastatic NSCLC (Stage IV).",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "diagnosis",
            "operator": "=",
            "value": "NSCLC"
          },
          {
            "field": "stage",
            "operator": "=",
            "value": "IV"
          }
        ]
      }
    },
    {
      "id": 2668,
      "text": "Documented progression after first-line platinum-based chemotherapy combined with anti-PD-1 or anti-PD-L1 therapy.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "first_line_therapy",
            "operator": "CONTAINS",
            "value": "platinum"
          },
          {
            "field": "first_line_immunotherapy",
            "operator": "IN",
            "value": [
              "anti-PD-1",
              "anti-PD-L1"
            ]
          },
          {
            "field": "progression_after_first_line",
            "operator": "=",
            "value": "yes"
          }
        ]
      }
    },
    {
      "id": 2669,
      "text": "ECOG Performance Status 0–1.",
      "logic": {
        "field": "ecog_ps",
        "operator": "<=",
        "value": "1"
      }
    },
    {
      "id": 2670,
      "text": "At least one measurable lesion per RECIST 1.1.",
      "logic": {
        "field": "measurable_lesion",
        "operator": "=",
        "value": "yes"
      }
    },
    {
      "id": 2671,
      "text": "Absolute neutrophil count (ANC) ≥ 1.5 x 10^9/L",
      "logic": {
        "field": "anc",
        "operator": ">=",
        "value": "1.5 x 10^9/L"
      }
    },
    {
      "id": 2672,
      "text": "Platelets ≥ 100 x 10^9/L",
      "logic": {
        "field": "platelet_count",
        "operator": ">=",
        "value": "100 x 10^9/L"
      }
    },
    {
      "id": 2673,
      "text": "Hemoglobin ≥ 9 g/dL",
      "logic": {
        "field": "hemoglobin",
        "operator": ">=",
        "value": "9 g/dL"
      }
    },
    {
      "id": 2674,
      "text": "AST and ALT ≤ 2.5 x ULN (≤ 5 x ULN if liver metastases)",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "ast_alt",
            "operator": "<=",
            "value": "2.5 x ULN"
          },
          {
            "unmapped": true,
            "source_text": "≤ 5 x ULN if liver metastases"
          }
        ]
      }
    },
    {
      "id": 2675,
      "text": "Total bilirubin ≤ 1.5 x ULN",
      "logic": {
        "field": "total_bilirubin",
        "operator": "<=",
        "value": "1.5 x ULN"
      }
    },
    {
      "id": 2676,
      "text": "Creatinine clearance ≥ 40 mL/min (CKD-EPI formula)",
      "logic": {
        "field": "creatinine_clearance",
        "operator": ">=",
        "value": "40"
      }
    },
    {
      "id": 2677,
      "text": "Women of childbearing potential must have a negative pregnancy test prior to treatment initiation.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "sex",
            "operator": "=",
            "value": "female"
          },
          {
            "field": "pregnancy_test_result",
            "operator": "=",
            "value": "negative"
          }
        ]
      }
    },
    {
      "id": 2678,
      "text": "Signed informed consent prior to any study-specific procedure.",
      "logic": {
        "field": "informed_consent_signed",
        "operator": "=",
        "value": "true"
      }
    }
  ],
  "exclusion_criteria": [
    {
      "id": 2679,
      "text": "Known EGFR, ALK, or ROS1 genomic alterations with available approved targeted therapy.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "molecular_status",
            "operator": "IN",
            "value": [
              "EGFR",
              "ALK",
              "ROS1"
            ]
          },
          {
            "field": "approved_targeted_therapy_available",
            "operator": "=",
            "value": "true"
          }
        ]
      }
    },
    {
      "id": 2680,
      "text": "Untreated brain metastases.",
      "logic": {
        "field": "brain_metastases_treatment",
        "operator": "=",
        "value": "untreated"
      }
    },
    {
      "id": 2681,
      "text": "symptomatic brain metastases.",
      "logic": {
        "field": "brain_metastases_symptomatic",
        "operator": "=",
        "value": "true"
      }
    },
    {
      "id": 2682,
      "text": "Active autoimmune disease requiring systemic immunosuppressive therapy.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "autoimmune_disease_status",
            "operator": "=",
            "value": "active"
          },
          {
            "field": "systemic_immunosuppressive_therapy_required",
            "operator": "=",
            "value": "true"
          }
        ]
      }
    },
    {
      "id": 2683,
      "text": "Interstitial lung disease.",
      "logic": {
        "field": "interstitial_lung_disease",
        "operator": "=",
        "value": "true"
      }
    },
    {
      "id": 2684,
      "text": "active non-infectious pneumonitis.",
      "logic": {
        "field": "pneumonitis_status",
        "operator": "=",
        "value": "active_non_infectious"
      }
    },
    {
      "id": 2685,
      "text": "Active infection requiring systemic therapy.",
      "logic": {
        "field": "infection_status",
        "operator": "=",
        "value": "active_requiring_systemic_therapy"
      }
    },
    {
      "id": 2686,
      "text": "Prior exposure to LUMITAX.",
      "logic": {
        "field": "lumitax_exposure",
        "operator": "=",
        "value": "yes"
      }
    },
    {
      "id": 2687,
      "text": "Other active invasive malignancy within 3 years (except adequately treated non-melanoma skin cancer or carcinoma in situ).",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "malignancy_status",
            "operator": "=",
            "value": "active_invasive"
          },
          {
            "field": "malignancy_recent_years",
            "operator": "<=",
            "value": "3"
          },
          {
            "field": "diagnosis",
            "operator": "NOT_IN",
            "value": "non-melanoma skin cancer"
          },
          {
            "field": "diagnosis",
            "operator": "NOT_IN",
            "value": "carcinoma in situ"
          }
        ]
      }
    }
  ]
}