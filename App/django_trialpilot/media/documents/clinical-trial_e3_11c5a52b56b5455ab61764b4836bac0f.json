        "operator": "AND",
        "conditions": [
          {
            "field": "treatment_name",
            "operator": "in",
            "value": "taxane"
          },
          {
            "field": "treatment_name",
            "operator": "=",
            "value": "trastuzumab"
          },
          {
            "field": "treatment_name",
            "operator": "=",
            "value": "pertuzumab"
          },
          {
            "field": "treatment_name",
            "operator": "=",
            "value": "T-DXd"
          },
          {
            "field": "progression_on_treatment",
            "operator": "=",
            "value": "T-DXd"
          }
        ]
      }
    },
    {
      "id": 93,
      "text": "Prior therapy with tucatinib, trastuzumab, and capecitabine, in advanced setting, is permissible, provided that T-DXd serves as the last systemic metastatic treatment line before inclusion, and patient subject presented disease progression on this drug.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "treatment_name",
            "operator": "in",
            "value": "tucatinib"
          },
          {
            "field": "treatment_name",
            "operator": "=",
            "value": "trastuzumab"
          },
          {
            "field": "treatment_name",
            "operator": "=",
            "value": "capecitabine"
          },
          {
            "field": "treatment_name",
            "operator": "=",
            "value": "T-DXd"
          },
          {
            "field": "progression_on_treatment",
            "operator": "=",
            "value": "T-DXd"
          }
        ]
      }
    },
    {
      "id": 94,
      "text": "Life expectancy â ¥ 6 months.",
      "logic": {
        "field": "life_expectancy_months",
        "operator": ">=",
        "value": "6"
      }
    },
    {
      "id": 95,
      "text": "At screening FDG-PET at least two \"target\" lesions are required to fulfil the following criteria: (1) anatomically transaxial diameter â ¥ 1.5 cm",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "number_of_target_lesions",
            "operator": ">=",
            "value": "2"
          },
          {
            "field": "lesion_diameter_cm",
            "operator": ">=",
            "value": "1.5"
          }
        ]
      }
    },
    {
      "id": 96,
      "text": "(2) metabolically assessable with a maximum standard uptake value corrected for lean body mass (SUVmax) â ¥ 1.5 x SUVmean + 2 standard deviations (SD) of the liver measured in a 3-cm-diameter spherical volume of interest (VOI) in normal liver parenchyma.",
      "logic": {
        "field": "lesion_suvmax_liver_ratio",
        "operator": ">=",
        "value": "1.5 * SUVmean_liver + 2 * SD_liver"
      }
    },
    {
      "id": 97,
      "text": "In case of suspected liver metastasis, a lesion should have a SUVmax â ¥ 2 x SUVmean + 3 SD of the blood pool measured in a 1 cm-diameter VOI within descending thoracic aorta.",
      "logic": {
        "field": "lesion_suvmax_bloodpool_ratio",
        "operator": ">=",
        "value": "2 * SUVmean_bloodpool + 3 * SD_bloodpool"
      }
    },
    {
      "id": 98,
      "text": "Lesions pre-treated with irradiation are not eligible for consideration as \"target\" lesions.",
      "logic": {
        "field": "lesion_pretreated_irradiation",
        "operator": "=",
        "value": "false"
      }
