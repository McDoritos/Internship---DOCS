{
  "inclusion_criteria": [
    {
      "id": 2857,
      "text": "Age ≥ 18 years.",
      "logic": {
        "field": "age",
        "operator": ">=",
        "value": "18"
      }
    },
    {
      "id": 2858,
      "text": "Histologically or cytologically confirmed metastatic NSCLC (Stage IV).",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "diagnosis",
            "operator": "=",
            "value": "NSCLC"
          },
          {
            "field": "stage",
            "operator": "=",
            "value": "IV"
          }
        ]
      }
    },
    {
      "id": 2859,
      "text": "Documented progression after first-line platinum-based chemotherapy combined with anti-PD-1 or anti-PD-L1 therapy.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "progression_after_first_line",
            "operator": "=",
            "value": "yes"
          },
          {
            "field": "treatment_name",
            "operator": "CONTAINS",
            "value": "platinum"
          },
          {
            "operator": "OR",
            "conditions": [
              {
                "field": "treatment_name",
                "operator": "CONTAINS",
                "value": "anti-PD-1"
              },
              {
                "field": "treatment_name",
                "operator": "CONTAINS",
                "value": "anti-PD-L1"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2860,
      "text": "ECOG Performance Status 0–1.",
      "logic": {
        "field": "ecog_ps",
        "operator": "IN",
        "value": "0,1"
      }
    },
    {
      "id": 2861,
      "text": "At least one measurable lesion per RECIST 1.1.",
      "logic": {
        "field": "measurable_lesion_count",
        "operator": ">=",
        "value": "1"
      }
    },
    {
      "id": 2862,
      "text": "Absolute neutrophil count (ANC) ≥ 1.5 x 10^9/L",
      "logic": {
        "field": "neutrofilos",
        "operator": ">=",
        "value": "1.5",
        "unit": "10^9/L"
      }
    },
    {
      "id": 2863,
      "text": "Platelets ≥ 100 x 10^9/L",
      "logic": {
        "field": "plaquetas",
        "operator": ">=",
        "value": "100",
        "unit": "10^9/L"
      }
    },
    {
      "id": 2864,
      "text": "Hemoglobin ≥ 9 g/dL",
      "logic": {
        "field": "hemoglobina",
        "operator": ">=",
        "value": "9",
        "unit": "g/dL"
      }
    },
    {
      "id": 2865,
      "text": "AST ≤ 2.5 x ULN (≤ 5 x ULN if liver metastases)",
      "logic": {
        "operator": "OR",
        "conditions": [
          {
            "operator": "AND",
            "conditions": [
              {
                "field": "liver_metastases",
                "operator": "=",
                "value": "yes"
              },
              {
                "field": "ast",
                "operator": "<=",
                "value": "5",
                "unit": "x ULN"
              }
            ]
          },
          {
            "operator": "AND",
            "conditions": [
              {
                "field": "liver_metastases",
                "operator": "!=",
                "value": "yes"
              },
              {
                "field": "ast",
                "operator": "<=",
                "value": "2.5",
                "unit": "x ULN"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2866,
      "text": "Total bilirubin ≤ 1.5 x ULN",
      "logic": {
        "field": "bilirrubina_total",
        "operator": "<=",
        "value": "1.5",
        "unit": "x ULN"
      }
    },
    {
      "id": 2867,
      "text": "Creatinine clearance ≥ 40 mL/min (CKD-EPI formula)",
      "logic": {
        "field": "creatinine_clearance",
        "operator": ">=",
        "value": "40",
        "unit": "mL/min"
      }
    },
    {
      "id": 2868,
      "text": "Women of childbearing potential must have a negative pregnancy test prior to treatment initiation.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "sex",
            "operator": "=",
            "value": "female"
          },
          {
            "field": "pregnancy_test",
            "operator": "=",
            "value": "negative"
          }
        ]
      }
    },
    {
      "id": 2869,
      "text": "Signed informed consent prior to any study-specific procedure.",
      "logic": {
        "field": "informed_consent_signed",
        "operator": "=",
        "value": "true"
      }
    }
  ],
  "exclusion_criteria": [
    {
      "id": 2870,
      "text": "Known EGFR, ALK, or ROS1 genomic alterations with available approved targeted therapy.",
      "logic": {
        "operator": "OR",
        "conditions": [
          {
            "field": "molecular_status",
            "operator": "=",
            "value": "EGFR"
          },
          {
            "field": "molecular_status",
            "operator": "=",
            "value": "ALK"
          },
          {
            "field": "molecular_status",
            "operator": "=",
            "value": "ROS1"
          }
        ]
      }
    },
    {
      "id": 2871,
      "text": "Untreated brain metastases.",
      "logic": {
        "field": "brain_metastases_status",
        "operator": "=",
        "value": "untreated"
      }
    },
    {
      "id": 2872,
      "text": "symptomatic brain metastases.",
      "logic": {
        "field": "brain_metastases_status",
        "operator": "=",
        "value": "symptomatic"
      }
    },
    {
      "id": 2873,
      "text": "Active autoimmune disease requiring systemic immunosuppressive therapy.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "autoimmune_disease_status",
            "operator": "=",
            "value": "active"
          },
          {
            "field": "immunosuppressive_therapy",
            "operator": "=",
            "value": "systemic"
          }
        ]
      }
    },
    {
      "id": 2874,
      "text": "Interstitial lung disease.",
      "logic": {
        "field": "interstitial_lung_disease_status",
        "operator": "=",
        "value": "present"
      }
    },
    {
      "id": 2875,
      "text": "active non-infectious pneumonitis.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "pneumonitis_status",
            "operator": "=",
            "value": "active"
          },
          {
            "field": "pneumonitis_type",
            "operator": "=",
            "value": "non_infectious"
          }
        ]
      }
    },
    {
      "id": 2876,
      "text": "Active infection requiring systemic therapy.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "infection_status",
            "operator": "=",
            "value": "active"
          },
          {
            "field": "infection_treatment",
            "operator": "=",
            "value": "systemic_therapy"
          }
        ]
      }
    },
    {
      "id": 2877,
      "text": "Prior exposure to LUMITAX.",
      "logic": {
        "field": "lumitax_exposure",
        "operator": "=",
        "value": "yes"
      }
    },
    {
      "id": 2878,
      "text": "Other active invasive malignancy within 3 years (except adequately treated non-melanoma skin cancer or carcinoma in situ).",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "malignancy_status",
            "operator": "=",
            "value": "active"
          },
          {
            "field": "malignancy_invasive",
            "operator": "=",
            "value": "yes"
          },
          {
            "field": "diagnosis_date",
            "operator": ">=",
            "value": "3 years ago"
          },
          {
            "field": "diagnosis",
            "operator": "NOT_IN",
            "value": "non-melanoma skin cancer"
          },
          {
            "field": "diagnosis",
            "operator": "NOT_IN",
            "value": "carcinoma in situ"
          }
        ]
      }
    }
  ]
}