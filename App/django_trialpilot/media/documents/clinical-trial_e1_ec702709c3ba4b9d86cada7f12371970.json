{
  "inclusion_criteria": [
    {
      "id": 2944,
      "text": "Age ≥ 18 years.",
      "logic": {
        "field": "age",
        "operator": ">=",
        "value": "18"
      }
    },
    {
      "id": 2945,
      "text": "Histologically or cytologically confirmed metastatic NSCLC (Stage IV).",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "diagnosis",
            "operator": "=",
            "value": "NSCLC"
          },
          {
            "field": "stage",
            "operator": "=",
            "value": "IV"
          }
        ]
      }
    },
    {
      "id": 2946,
      "text": "Documented progression after first-line platinum-based chemotherapy combined with anti-PD-1 or anti-PD-L1 therapy.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "treatment_name",
            "operator": "CONTAINS",
            "value": "platinum"
          },
          {
            "operator": "OR",
            "conditions": [
              {
                "field": "treatment_name",
                "operator": "CONTAINS",
                "value": "anti-PD-1"
              },
              {
                "field": "treatment_name",
                "operator": "CONTAINS",
                "value": "anti-PD-L1"
              }
            ]
          },
          {
            "field": "first_line_progression_documented",
            "operator": "=",
            "value": "yes"
          }
        ]
      }
    },
    {
      "id": 2947,
      "text": "ECOG Performance Status 0–1.",
      "logic": {
        "field": "ecog_ps",
        "operator": "IN",
        "value": "0,1"
      }
    },
    {
      "id": 2948,
      "text": "At least one measurable lesion per RECIST 1.1.",
      "logic": {
        "field": "measurable_lesion_count",
        "operator": ">=",
        "value": "1"
      }
    },
    {
      "id": 2949,
      "text": "Absolute neutrophil count (ANC) ≥ 1.5 x 10^9/L",
      "logic": {
        "field": "neutrofilos",
        "operator": ">=",
        "value": "1.5",
        "unit": "x 10^9/L"
      }
    },
    {
      "id": 2950,
      "text": "Platelets ≥ 100 x 10^9/L",
      "logic": {
        "field": "plaquetas",
        "operator": ">=",
        "value": "100",
        "unit": "x 10^9/L"
      }
    },
    {
      "id": 2951,
      "text": "Hemoglobin ≥ 9 g/dL",
      "logic": {
        "field": "hemoglobina",
        "operator": ">=",
        "value": "9",
        "unit": "g/dL"
      }
    },
    {
      "id": 2952,
      "text": "AST and ALT ≤ 2.5 x ULN (≤ 5 x ULN if liver metastases)",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "ast",
            "operator": "<=",
            "value": "2.5",
            "unit": "x ULN"
          },
          {
            "field": "alt",
            "operator": "<=",
            "value": "2.5",
            "unit": "x ULN"
          },
          {
            "unmapped": true,
            "source_text": "≤ 5 x ULN if liver metastases"
          }
        ]
      }
    },
    {
      "id": 2953,
      "text": "Total bilirubin ≤ 1.5 x ULN",
      "logic": {
        "field": "bilirrubina_total",
        "operator": "<=",
        "value": "1.5",
        "unit": "x ULN"
      }
    },
    {
      "id": 2954,
      "text": "Creatinine clearance ≥ 40 mL/min (CKD-EPI formula)",
      "logic": {
        "field": "creatinine_clearance",
        "operator": ">=",
        "value": "40",
        "unit": "mL/min"
      }
    },
    {
      "id": 2955,
      "text": "Women of childbearing potential must have a negative pregnancy test prior to treatment initiation.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "gender",
            "operator": "=",
            "value": "female"
          },
          {
            "field": "pregnancy_test_result",
            "operator": "=",
            "value": "negative"
          }
        ]
      }
    },
    {
      "id": 2956,
      "text": "Signed informed consent prior to any study-specific procedure.",
      "logic": {
        "field": "informed_consent_signed",
        "operator": "=",
        "value": "true"
      }
    }
  ],
  "exclusion_criteria": [
    {
      "id": 2957,
      "text": "Known EGFR, ALK, or ROS1 genomic alterations with available approved targeted therapy.",
      "logic": {
        "field": "molecular_status",
        "operator": "IN",
        "value": "EGFR, ALK, ROS1"
      }
    },
    {
      "id": 2958,
      "text": "Untreated or symptomatic brain metastases.",
      "logic": {
        "field": "brain_metastases",
        "operator": "IN",
        "value": "untreated, symptomatic"
      }
    },
    {
      "id": 2959,
      "text": "Active autoimmune disease requiring systemic immunosuppressive therapy.",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "autoimmune_disease",
            "operator": "=",
            "value": "active"
          },
          {
            "field": "immunosuppressive_therapy",
            "operator": "=",
            "value": "required"
          }
        ]
      }
    },
    {
      "id": 2960,
      "text": "Interstitial lung disease or active non-infectious pneumonitis.",
      "logic": {
        "operator": "OR",
        "conditions": [
          {
            "field": "interstitial_lung_disease",
            "operator": "=",
            "value": "present"
          },
          {
            "field": "pneumonitis",
            "operator": "=",
            "value": "active"
          }
        ]
      }
    },
    {
      "id": 2961,
      "text": "Active infection requiring systemic therapy.",
      "logic": {
        "field": "infection_status",
        "operator": "=",
        "value": "active"
      }
    },
    {
      "id": 2962,
      "text": "Prior exposure to LUMITAX.",
      "logic": {
        "field": "treatment_name",
        "operator": "NOT_IN",
        "value": "LUMITAX"
      }
    },
    {
      "id": 2963,
      "text": "Other active invasive malignancy within 3 years (except adequately treated non-melanoma skin cancer or carcinoma in situ).",
      "logic": {
        "operator": "AND",
        "conditions": [
          {
            "field": "active_invasive_malignancy_within_3_years",
            "operator": "=",
            "value": "yes"
          },
          {
            "field": "diagnosis",
            "operator": "NOT_IN",
            "value": "non-melanoma skin cancer"
          },
          {
            "field": "diagnosis",
            "operator": "NOT_IN",
            "value": "carcinoma in situ"
          }
        ]
      }
    }
  ]
}